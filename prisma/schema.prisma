generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("STAFF") // ADMIN, STAFF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id           String       @id @default(cuid())
  name         String
  mobile       String       @unique
  position     String?
  dailySalary  Float        @default(0)
  status       String       @default("Active") // Active, Inactive
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // Stored as midnight for the given day
  status     String   // PRESENT, ABSENT, LATE
  checkIn    DateTime?
  checkOut   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
}

model Customer {
  id             String    @id @default(cuid())
  name           String
  mobile         String    @unique
  totalPurchased Float     @default(0)
  bills          Bill[]
  projects       Project[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  name           String
  category       String?
  unit           String          @default("Pcs") // Sheet, Pcs, Box, etc.
  sellingPrice   Float
  purchasePrice  Float?
  stock          Float           @default(0)
  lowStockLimit  Float           @default(10)
  billItems      BillItem[]
  materialUsages MaterialUsage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Bill {
  id            String       @id @default(cuid())
  billNumber    String       @unique
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  subtotal      Float        @default(0)
  discount      Float        @default(0)
  tax           Float        @default(0)
  grandTotal    Float        @default(0)
  paymentStatus String       @default("PENDING") // PAID, PARTIAL, PENDING
  items         BillItem[]
  payments      Payment[]
  date          DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model BillItem {
  id        String   @id @default(cuid())
  billId    String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  price     Float
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount        Float
  method        String   // CASH, UPI, BANK_TRANSFER, CARD
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Project {
  id             String          @id @default(cuid())
  name           String
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  siteAddress    String?
  startDate      DateTime?
  deadline       DateTime?
  status         String          @default("PLANNING") // PLANNING, IN_PROGRESS, COMPLETED
  notes          String?
  materialUsages MaterialUsage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MaterialUsage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  area      String?  // Kitchen, Bedroom, etc.
  quantity  Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Estimate {
  id             String   @id @default(cuid())
  estimateNumber String   @unique
  clientName     String?
  clientMobile   String?
  propertyType   String   // 1BHK, 2BHK, 3BHK, 4BHK, VILLA, STUDIO, OFFICE, CUSTOM
  totalSqft      Float
  qualityTier    String   // ECONOMY, STANDARD, LUXURY
  style          String?  // MODERN, MINIMALIST, LUXURY, TRADITIONAL, SCANDINAVIAN
  totalCost      Float
  roomsData      String   // JSON stringified array of rooms & furniture items
  bomData        String?  // JSON stringified Bill of Materials (plywood, laminates, hardware)
  notes          String?
  status         String   @default("DRAFT") // DRAFT, SENT, CONVERTED_TO_PROJECT, CONVERTED_TO_BILL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

